{
  "name": "toolhub-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:web": "npm --workspace=apps/web run dev",
    "build:web": "npm --workspace=apps/web run build",
    "dev:server": "cargo run -p toolhub-fleet",
    "build:server": "cargo build --release -p toolhub-fleet",
    "test:android": "./gradlew testDebugUnitTest",
    "build:android": "./gradlew :app:assembleRelease"
  }
}
